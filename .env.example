# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Кому бот отвечает: chat id через запятую (узнать — /chatid у бота). Пусто — всем.
ALLOWED_CHAT_IDS=
# Публичный адрес сервера для webhook (https://...). Пусто — long polling (удобно на своём ПК).
PUBLIC_URL=

# LLM: любой OpenAI-совместимый API (OpenAI, OpenRouter...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Сервер
PORT=3000
DB_FILE=data/maid.sqlite
DEFAULT_TIMEZONE=Europe/Moscow
# Токен для десктопа (любая длинная строка; тот же — в настройках десктопа)
DESKTOP_TOKEN=

# Google Таблица-зеркало (необязательно)
# JSON сервисного аккаунта; таблицу нужно расшарить на его e-mail с правом редактора
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
SHEETS_SPREADSHEET_ID=
