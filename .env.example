# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Кому бот отвечает: chat id через запятую (узнать — /chatid у бота). Пусто — всем.
ALLOWED_CHAT_IDS=
# Публичный адрес сервера для webhook (https://...). Пусто — long polling (удобно на своём ПК).
PUBLIC_URL=

# LLM: любой OpenAI-совместимый API (OpenAI, OpenRouter...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Распознавание голосовых (/audio/transcriptions). Пусто — те же адрес и ключ, что у LLM.
# Модель по умолчанию — по адресу: OpenRouter openai/whisper-large-v3, Groq whisper-large-v3, иначе whisper-1.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# Сервер
PORT=3000
DB_FILE=data/maid.sqlite
DEFAULT_TIMEZONE=Europe/Moscow
# Токен для десктопа (любая длинная строка; тот же — в настройках десктопа)
DESKTOP_TOKEN=

# Postgres на Render (Internal Database URL). Пусто — SQLite из DB_FILE
DATABASE_URL=

# Web Push (уведомления в браузере и на iPhone): npm --workspace server run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
