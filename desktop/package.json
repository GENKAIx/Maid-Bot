{
  "name": "maid-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Горничная на ПК: окно, виджет поверх всех окон, трекер активности",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8"
  },
  "productName": "Горничная",
  "author": "GENKAIx",
  "build": {
    "appId": "cloud.genkaix.maid",
    "productName": "Горничная",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Горничная",
      "artifactName": "Gornichnaya-Setup-${version}.exe"
    },
    "electronVersion": "45.2.3"
  }
}
