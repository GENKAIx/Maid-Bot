{
  "name": "maid-desktop",
  "version": "0.1.39",
  "private": true,
  "description": "Горничная на ПК: окно, виджет поверх всех окон, трекер активности",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8"
  },
  "productName": "Горничная",
  "author": "GENKAIx",
  "build": {
    "appId": "cloud.genkaix.maid",
    "productName": "Горничная",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "include": "installer.nsh",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Горничная",
      "artifactName": "Gornichnaya-Setup-${version}.exe"
    },
    "electronVersion": "45.2.3",
    "publish": [
      {
        "provider": "generic",
        "url": "https://maid.invalid/desktop/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "3.3.8"
  }
}
