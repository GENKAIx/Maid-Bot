# Домены → контейнеры. HTTPS Caddy выпускает сам (Let's Encrypt), когда домен указывает на этот сервер.
# Новый сервис: ещё один блок «имя.домен { reverse_proxy контейнер:порт }».
{$MAID_DOMAIN:maid.localhost} {
    encode gzip
    reverse_proxy maid:3000
}

# Старый адрес http://<ip> (до HTTPS): только перенаправление на https — без шифрования ничего не обслуживается.
{$MAID_OLD:http://old.localhost} {
    redir https://{$MAID_HOST:maid.localhost}{uri} 308
}
